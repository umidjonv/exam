# PostgreSQL Database Configuration
POSTGRES_DB=EX
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_MAX_CONNECTIONS=300

# Application Environment
ASPNETCORE_ENVIRONMENT=Production

# Database Connection String
DB_HOST=postgres
DB_PORT=5432
DB_NAME=EX
DB_USER=postgres
DB_PASSWORD=12345

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
API_URL=http://ex-api:10001

# Web Configuration
WEB_URL=http://ex-web:10000

# External Services (Optional - Update with your actual values)
IDENTITY_PROVIDER_URL=http://sp-id.uzex.uz
TOKEN_SERVICE_URL=http://sso.uzex.uz
IDENTITY_API_URL=http://sp-id-api.uzex.uz
HANDBOOK_API_URL=http://192.168.15.22:2001
MAILBOX_URL=http://192.168.15.22:7000
NOTIFICATION_API_URL=http://192.168.15.22:3000

# MinIO Configuration (Optional)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=web@1234

# JWT Configuration
JWT_SECRET_KEY=ThisIsASecretKeyForBearerAuthenticationWithNoExpiration2025
