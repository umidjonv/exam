@model PagerLocaleViewModel<QuestionViewModel>
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}
@section Styles
{
    <link href="~/lib/DataTables/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
}

<div class="test-table">
    <div class="dash-card">
        <div class="test-table__header">
            <div>
                <a asp-action="Form" class="btn btn-success">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    @Localizer["CreateNew"]
                </a>
                <button type="button" class="btn btn-warning" data-toggle="modal" data-target="#exampleModalCenter">
                    <i class="fa fa-file-excel-o" aria-hidden="true"></i>@Localizer["ExcelUpload"]
                </button>

            </div>
            <ul class="pagination pagination-warning justify-content-center">
                @foreach (var item in Model.Cultures)
                {

                    @if (item.Id == Model.Lang)
                    {
                        <li class="page-item active">
                            <span class="page-link">
                                @item.Name
                            </span>
                        </li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new {lang = item.Id})">
                                @item.Name
                            </a>
                        </li>
                    }
                }
            </ul>
            <div class="test-table__header__pagination">
                @Html.PagedListPager(Model.Items, page => Url.Action("Index", new { page }), new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },
                    Display = PagedListDisplayMode.IfNeeded
                })
            </div>
        </div>
        <div class="scroll">
            <table id="example" class="table">
                <thead class="thead-dark">
                    <tr>
                        <th>@Localizer["Title"]</th>
                        <th width="20%">@Localizer["Category"]</th>
                        <th width="10%">@Localizer["Base"]</th>
                        <th width="10%">@Localizer["ChangeTime"]</th>
                        <th width="15%"></th>
                        <th width="15%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var locale = item.Locales.FirstOrDefault(a => a.CultureId == Model.Lang);
                        var rowClass = item.IsBase ? "table-success" : "table-danger";

                        <tr class="@rowClass">
                            <td>
                                @(locale?.Title)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CategoryName)
                            </td>      
                            <td align="center">
                                @if (item.IsBase)
                                {
                                    <i class="fa fa-check-square-o fa-2" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="fa fa-square-o fa-2" aria-hidden="true"></i>
                                } 
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ModifiedDate)
                            </td>
                            <td align="center">
                                <a asp-action="Form" class="btn btn-info" data-toggle="tooltip" title="@Localizer["Edit"]" asp-route-id="@item.Id">
                                    <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                                </a>
                            </td>
                            <td align="center">
                                <form asp-action="Delete" asp-route-id="@item.Id">
                                    <button class="btn btn-danger" type="submit" data-toggle="tooltip" title="@Localizer["Delete"]" onclick="return deleteConfirm(this)">
                                        <i class="fa fa-trash-o" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">
                    @Localizer["ChoiceFile"]
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="UploadExcel" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="form-group">
                        <select asp-items="ViewBag.CategoryList"  name="categoryId" class="form-control" required>
                            <option value="" disabled selected hidden>@Localizer["SelectCategory"]</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input type="file" required id="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" name="uploadedFile"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Close"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Upload"]</button>
                </div>
            </form>
        </div>
    </div>
</div>