@model ExamResultViewModel
@inject IViewLocalizer Localizer
@inject ExamService Service
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var isOnline = Model.Schedule != null && Model.Schedule.Mode == ExamMode.Online && ViewBag.Files != null;
}
@section Styles
{
    @if (isOnline)
    {
        <link href="~/lib/mediaelement/mep-feature-playlist.css" rel="stylesheet" />
        <link href="~/lib/mediaelement/mediaelementplayer.min.css" rel="stylesheet" />
        <style>
            video, .mejs__video, .mejs__layer {
                width: 640px !important;
                height: 480px !important;
            }
        </style>
    }

    <style>
        .nav-link.active span,
        .nav-link.active i {
            color: white !important;
        }
    </style>
}
<form asp-action="Form" id="form1">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="@(isOnline?"col-6":"col-12")">
            <div class="form-group">
                <label class="control-label">@Localizer["CorrectAnswers"]</label>
                <input readonly="readonly" disabled="disabled" value="@ViewBag.TotalCorrectCount" class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">@Localizer["Questions"]</label>
                <div class="row">
                    <div class="@(isOnline?"col-3":"col-2")">
                        <div style="overflow: auto; max-height: 30vh;">
                            <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                                @{
                                    var counterColumn = 1;
                                }
                                @foreach (var item in Model.Units)
                                {
                                    var active = counterColumn == 1 ? "active" : "";

                                    @if ((string)ViewData[$"{item.QuestionId}"] == "true")
                                    {
                                        <a class="nav-link text-success @(active)" id="v-pills-@item.QuestionId-tab" data-toggle="pill" href="#v-pills-@item.QuestionId" role="tab" aria-controls="v-pills-@item.QuestionId" aria-selected="false">
                                            <span class="text-dark pr-4">@counterColumn.ToString()</span><i class="fa fa-check-circle" aria-hidden="true"></i>
                                        </a>
                                    }
                                    else if ((string)ViewData[$"{item.QuestionId}"] == "false")
                                    {
                                        <a class="nav-link text-danger @(active)" id="v-pills-@item.QuestionId-tab" data-toggle="pill" href="#v-pills-@item.QuestionId" role="tab" aria-controls="v-pills-@item.QuestionId" aria-selected="false">
                                            <span class="text-dark pr-4">@counterColumn.ToString()</span><i class="fa fa-times-circle" aria-hidden="true"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="nav-link text-secondary @(active)" id="v-pills-@item.QuestionId-tab" data-toggle="pill" href="#v-pills-@item.QuestionId" role="tab" aria-controls="v-pills-@item.QuestionId" aria-selected="false">
                                            <span class="text-dark pr-4">@counterColumn.ToString()</span><i class="fa fa-ban" aria-hidden="true"></i>
                                        </a>
                                    }
                                    counterColumn += 1;
                                }
                            </div>
                        </div>
                    </div>
                    <div class="@(isOnline?"col-9":"col-10")">
                        <div class="tab-content" id="v-pills-tabContent">
                            @{
                                var counterRow = 1;
                            }
                            @foreach (var item in Model.Units)
                            {
                                var locale = item.Question.Locales.FirstOrDefault(a => a.CultureId == ViewBag.Lang);
                                var active = counterRow == 1 ? "show active" : "";

                                <div class="tab-pane fade @(active)" id="v-pills-@item.QuestionId" role="tabpanel" aria-labelledby="v-pills-@item.QuestionId-tab">
                                    <p>
                                        @(locale?.Title)
                                    </p>
                                    <ul class="list-group list-group-flush">

                                        @if (item.AnswerId != null)
                                        {
                                            @foreach (var answer in item.Answer.QuestionLocale.Answers.OrderBy(a => a.Order))
                                            {
                                                var selected = "";
                                                var correct = "";

                                                if ((string)ViewData[$"selected_{answer.Id}"] == "yes")
                                                {
                                                    selected = "active";
                                                }

                                                if ((string)ViewData[$"correct_{answer.Id}"] == "yes")
                                                {
                                                    correct = "font-style: italic;text-decoration: underline;";
                                                }
                                                <li class="list-group-item @(selected)" style="@(correct)"><strong>@answer.Order)</strong> @answer.Title</li>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var answer in locale.Answers.OrderBy(a => a.Order))
                                            {
                                                <li class="list-group-item"><strong>@answer.Order)</strong> @answer.Title</li>
                                            }
                                        }
                                    </ul>
                                </div>

                                counterRow += 1;
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="StatusReason" class="control-label">@Localizer["StatusReason"]</label>
                @if (Model.IsAccepted != null)
                {
                    <textarea readonly="readonly" disabled="disabled"  class="form-control" rows="5">@Model.StatusReason</textarea>
                }
                else
                {
                    <textarea asp-for="StatusReason" class="form-control" rows="5"></textarea>
                }
            </div>
            <div class="form-row">
                <div class="col">
                    <label asp-for="StartTime" class="col-form-label">@Localizer["StartTime"]</label>
                    <input readonly="readonly" disabled="disabled" value="@Model.StartTime" class="form-control" />
                </div>
                <div class="col">
                    <label asp-for="FinishTime" class="col-form-label">@Localizer["FinishTime"]</label>
                    <input readonly="readonly" disabled="disabled" value="@Model.FinishTime" class="form-control" />
                </div>
            </div>
            <div class="form-group row mt-3">
                <div class="col-sm-12">

                    <input type="hidden" asp-for="IsAccepted" name="action"/>

                    @if (Model.IsAccepted == null)
                    {
                        <button type="button" class="btn btn-success" onclick="return changeStatus(this,true);">
                            @Localizer["Accept"]
                        </button>
                        <button type="button" class="btn btn-danger" onclick="return changeStatus(this,false);">
                            @Localizer["Reject"]
                        </button>
                    } 
                </div>
            </div>
        </div>
        <div class="@(isOnline?"col-6":"")">
            @if (isOnline)
            {
                <video id="player1" data-showplaylist="true" preload="none" controls>
                    @{
                        var counter = 0;
                        var items = (IEnumerable<string>)ViewBag.Files;
                        var size = items.Count();
                    }
                    @foreach (var item in items)
                    {
                        counter++;

                        <source src="@Url.Action("Download", new {userId = Model.UserId, file = item})" type="video/mp4" title="@(counter) кадр" data-mep-description="@($"{counter}/{size} мин")">
                    }
                </video>
            }
        </div>
    </div>
</form>

@section Scripts
{

    <script>
        function changeStatus(e, accept) {

            if ($("#form1").valid()) {
                $("#IsAccepted").val(accept);

                $("#form1")[0].submit();

                $(e).html('<p><span class="spinner-border"></span> Загружается...</p>');

                return true;
            }

            return false;
        }
    </script>

    @if (isOnline)
    {
        <script src="~/lib/mediaelement/mediaelement-and-player.min.js"></script>
        <script src="~/lib/mediaelement/mep-feature-playlist.js"></script>
        <script>

            $(function () {

                $('#player1').mediaelementplayer({
                    playlistposition: 'bottom',
                    alwaysShowControls: true,
                    alwaysShowPlaylist: true,
                    pluginPath: "/lib/mediaelement",
                    features: ['playlistfeature', 'prevtrack', 'playpause', 'nexttrack', 'loop', 'playlist', 'current', 'progress', 'duration', 'volume', 'fullscreen']
                });

            });

        </script>
    }
}
