@model ScheduleViewModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}
<form asp-action="Form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">        
        <label asp-for="StartDate" class="control-label">@Localizer["StartDate"]</label>
        <input type="text" asp-for="StartDate" class="form-control" placeholder="дд/ММ/гггг чч:мм" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RegionId" class="control-label">@Localizer["Region"]</label>
        <select asp-for="RegionId" asp-items="ViewBag.RegionList" class="form-control"></select>
        <span asp-validation-for="RegionId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ExamId" class="control-label">@Localizer["Title"]</label>
        <select asp-for="ExamId" asp-items="ViewBag.ExamList" class="form-control"></select>
        <span asp-validation-for="ExamId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Mode" class="control-label">@Localizer["Mode"]</label>
        <select asp-for="Mode" asp-items="Html.GetEnumSelectList<ExamMode>()" class="form-control"></select>
        <span asp-validation-for="Mode" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LimitOfParticipants" class="control-label">@Localizer["MaxMemberCount"]</label>
        <input type="number" asp-for="LimitOfParticipants" class="form-control" />
        <span asp-validation-for="LimitOfParticipants" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="Id" />
    <div class="form-group text-center">
        <input type="submit" value="@Localizer["Save"]" class="btn btn-primary btn-lg" />
    </div>
</form>

@section Scripts
{
    <script src="~/lib/inputmask/inputmask.min.js"></script>
    <script src="~/lib/inputmask/inputmask.binding.js"></script>
    <script>
        $(function () {

            Inputmask("99/99/9999 99:99").mask(document.querySelector("#StartDate") || {});

        });
    </script>
}
