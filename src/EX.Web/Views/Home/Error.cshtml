@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<section class="section">
    <div class="container">
        <div class="title">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="container">
            <p class="text-danger">
                @if (Model == null)
                {
                    @:Произошла ошибка при обработке вашего запроса.
                }
                else
                {
                    @Model.Exception
                }
            </p>
            <p class="text-center">
                <button onclick="window.history.back()" class="btn btn-warning">
                    Назад
                </button>
            </p>
        </div>
    </div>
</section>
