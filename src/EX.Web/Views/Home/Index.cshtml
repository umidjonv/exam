@inject AppConfig Config
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
    ViewBag.ShowLanding = true;
}

@section Styles{
    <link href="~/css/owl.carousel.css" rel="stylesheet" />
}

<!-- Main slider -->
<section class="section section-main-slider">
    <div id="main_slider" class="owl-carousel main-slider">
        <div class="item">
            <div class="main-slider__item">
                <img src="~/images/slider-image.jpg" alt="">
                <div class="main-slider__caption">
                    <div class="main-slider__caption-inner">
                        <h2>@Localizer["SlideTitle"]</h2>
                        <p>@Localizer["SlideDescription"]</p>
                        <a href="#" onclick="goSelector('#docs')" class="btn btn-success btn-lg">
                            <i class="fa fa-angle-double-down" aria-hidden="true"></i>
                            @Localizer["SlideButton"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="item">
            <div class="main-slider__item">
                <img src="~/images/slider-image.jpg" alt="">
                <div class="main-slider__caption">
                    <div class="main-slider__caption-inner">
                        <h2>@Localizer["DownloadApp"]</h2>
                        <p>@Localizer["SlideDescription"]</p>
                        <a href="#" onclick="goSelector('#apps')" class="btn btn-success btn-lg">
                            <i class="fa fa-download" aria-hidden="true"></i>
                            @Localizer["DownloadButton"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Examination system -->
<section class="section section-examination-system" id="landing">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <img src="~/images/intro.png" alt="">
            </div>
            <div class="col-lg-6">
                <div class="title title--left">
                    <h2>Examination System</h2>
                    <p>@Localizer["ViaExaminationSystem"]</p>
                </div>
                <div class="ex-system">
                    <div class="ex-system__item">
                        <img src="~/images/steps-icons/1.svg" alt="">
                        <p>@Localizer["LearnTheRules"]</p>
                    </div>
                    <div class="ex-system__item">
                        <img src="~/images/steps-icons/2.svg" alt="">
                        <p>@Localizer["PassTestsSuccessfully"]</p>
                    </div>
                    <div class="ex-system__item">
                        <img src="~/images/steps-icons/3.svg" alt="">
                        <p>@Localizer["BeBroker"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

