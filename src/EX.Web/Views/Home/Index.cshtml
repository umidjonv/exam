    <div class="container">
        <div class="title">
            <h2>@Localizer["DownloadApp"]</h2>
        </div>
        <div class="download-app-slider">
            <div id="download_app_slider_nav" class="owl-nav"></div>
            <div id="download_app_slider" class="owl-carousel">
