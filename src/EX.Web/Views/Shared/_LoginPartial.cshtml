@inject IViewLocalizer Localizer
@inject AppConfig Config
@{
    var hostUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/signout";
}
@if (User.Identity.IsAuthenticated)
{
    @if (ViewBag.ShowDashboard != null)
    {
        <a href="/home/profile" class="header__profile__welcome">
            <strong>@User.FindFirstValue("name")</strong>
        </a>
        <a href="#" class="header__profile__image">
            <img src="/images/noavatar.png" alt="">
        </a>
        <div class="header__profile__logout">
            <a class="btn btn-danger text-white" href="/signout?redirectUrl=/">
                @Localizer["LogoutTitle"]
            </a>
        </div>
    }
    else
    {
        <button class="btn btn-success" type="button" onclick="location.href = '/home/profile';">
            @Localizer["ProfileTitle"]
        </button>
        <button class="btn btn-danger" onclick="location.href = '/signout?redirectUrl=/';">
            @Localizer["LogoutTitle"]
        </button>
    }
}
else
{
    <button class="btn btn-success" type="button" onclick="location.href = '/signin';">
        @Localizer["LoginTitle"]
    </button>
    <button class="btn btn-secondary" type="button" disabled title="Registration not available">
        @Localizer["RegisterTitle"]
    </button>
}
